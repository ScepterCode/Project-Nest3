{
  "check_constraints": [
    {
      "conname": "assignments_status_check",
      "def": "CHECK ((status = ANY (ARRAY['draft'::text, 'published'::text, 'closed'::text])))"
    },
    {
      "conname": "points_possible_non_negative",
      "def": "CHECK ((points_possible >= 0))"
    },
    {
      "conname": "submissions_grade_check",
      "def": "CHECK (((grade >= 0) AND (grade <= 100)))"
    },
    {
      "conname": "submissions_status_check",
      "def": "CHECK ((status = ANY (ARRAY['draft'::text, 'submitted'::text, 'graded'::text])))"
    }
  ],
  "triggers": [
    {
      "tbl": "submissions",
      "tgname": "guard_submission_grading",
      "def": "CREATE TRIGGER guard_submission_grading BEFORE INSERT OR UPDATE ON public.submissions FOR EACH ROW EXECUTE FUNCTION app_private.guard_submission_grading()"
    }
  ],
  "points_columns": [
    {
      "column_name": "points",
      "is_nullable": "YES",
      "column_default": "100"
    },
    {
      "column_name": "points_possible",
      "is_nullable": "YES",
      "column_default": "100"
    }
  ],
